{
  "name": "ai-clone-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "module1:dry-run": "node src/module1/cli.js --config configs/module1.demo.json --dry-run",
    "module1:run": "node src/module1/cli.js --config configs/module1.demo.json",
    "check": "node --check src/module1/cli.js && node --check src/module1/runner.js && node --check src/module1/kling/client.js && node --check src/server/dev-server.js",
    "dev": "node src/server/dev-server.js",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql"
  },
  "engines": {
    "node": ">=20"
  }
}
