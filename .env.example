
# Task polling and reusable element creation endpoints must be verified
# against the account/docs before enabling in production.
# Example if your account exposes it:
# KLING_TASK_STATUS_PATH_TEMPLATE=/v1/tasks/{task_id}

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Optional override. If unset, server reads config/director-instruction.txt
DIRECTOR_INSTRUCTION=

# Kling API auth
# Kling gives an Access Key + Secret Key. The server signs a short-lived JWT from these.
KLING_ACCESS_KEY=replace-with-kling-access-key
KLING_SECRET_KEY=replace-with-kling-secret-key
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_TASK_STATUS_PATH_TEMPLATE=/v1/videos/omni-video/{task_id}

# Optional: if you already generated a Kling bearer/JWT manually, this overrides access+secret.
KLING_API_TOKEN=

# Kling smoke-test settings
KLING_MODEL=omni-v3
KLING_TEST_DURATION_SECONDS=10
KLING_TEST_MODE=std
KLING_TEST_POLL_MS=5000

# Kling image generation settings for Influencer Studio Step 0.
# If Kling changes the text-to-image endpoint for your account, adjust these
# without touching code.
KLING_IMAGE_MODEL=kling-v2-1
KLING_IMAGE_CREATE_PATH=/v1/images/generations
KLING_IMAGE_STATUS_PATH_TEMPLATE=/v1/images/generations/{task_id}
KLING_IMAGE_POLL_MS=5000
